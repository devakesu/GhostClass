{
  "lint": {
    "include": [
      "src/lib",
      "src/app/api"
    ],
    "exclude": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.spec.js",
      "**/*.spec.jsx",
      "**/node_modules/**",
      "**/.next/**",
      "**/mobile/**",
      "**/Temp/**",
      "**/public/sw.js"
    ],
    "rules": {
      "exclude": [
        "no-sloppy-imports",
        "no-window"
      ]
    }
  },
  "allowScripts": [
    "npm:@firebase/util@1.15.2",
    "npm:@sentry/cli@2.58.6",
    "npm:esbuild@0.28.1",
    "npm:protobufjs@7.6.5",
    "npm:unrs-resolver@1.12.2"
  ]
}
