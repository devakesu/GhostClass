/// Template for AppSecrets. 
/// 
/// TO USE: 
/// 1. Copy this file to 'lib/config/app_secrets.dart'
/// 2. Fill in your sensitive values for Dev/Prod and shared EzyGo fields.
class AppSecrets {
  AppSecrets._();

  // ─── Environment ──────────────────────────────────────────────────────────
  
  /// Set to true to use Development credentials, false for Production.
  static const bool isDev = true;

  // ─── Supabase Config (Dev) ──────────────────────────────────────────────────
  static const String supabaseUrlDev = ''; 
  static const String supabasePublishableKeyDev = ''; 

  // ─── Supabase Config (Prod) ─────────────────────────────────────────────────
  static const String supabaseUrlProd = ''; 
  static const String supabasePublishableKeyProd = ''; 

  // ─── Backend & Bridge Config (Dev) ──────────────────────────────────────────
  static const String ghostclassApiUrlDev = ''; // Plain string (not encoded)
  static const String mobileApiSecretDev = ''; 

  // ─── Backend & Bridge Config (Prod) ─────────────────────────────────────────
  static const String ghostclassApiUrlProd = ''; // Plain string (not encoded)
  static const String mobileApiSecretProd = ''; 

  // ─── EzyGo Config (Shared: Dev + Prod) ─────────────────────────────────────
  static const String ezygoAuthUrl = ''; 
  static const String ezygoApiRoot = ''; 
  static const String ezygoOrigin = ''; 

  // ─── Sentry Config ──────────────────────────────────────────────────────────
  static const String sentryDsn = ''; // Base64 encoded

  // ─── Supabase Config (Shared) ──────────────────────────────────────────────
  static const String supabaseSpoofedOrigin = '';

  // ─── Diagnostic Config ──────────────────────────────────────────────────────
  static const String diagnosticJwksUrl = '';
}
