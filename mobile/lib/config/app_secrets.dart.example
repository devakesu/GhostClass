import 'package:flutter/foundation.dart';

/// Template for AppSecrets.
///
/// IMPORTANT: All sensitive string values are base64-encoded by the CI/CD workflow
/// (see .github/workflows/release.yml). This prevents sensitive values from appearing
/// in plaintext in the compiled binary.
///
/// TO USE FOR LOCAL DEVELOPMENT:
/// 1. Copy this file to 'lib/config/app_secrets.dart'
/// 2. Base64-encode your values: echo -n 'value' | base64
/// 3. Fill in the encoded values below.
class AppSecrets {
  AppSecrets._();

  // ─── Environment ──────────────────────────────────────────────────────────

  /// Automatically determined based on build mode.
  static const bool isDev = kDebugMode;

  // ─── Supabase Config (Dev) ──────────────────────────────────────────────────
  // Base64-encoded for obfuscation
  static const String supabaseUrlDev = 'ZHVtbXk=';
  static const String supabasePublishableKeyDev = 'ZHVtbXk=';

  // ─── Supabase Config (Prod) ─────────────────────────────────────────────────
  // Base64-encoded for obfuscation
  static const String supabaseProxyUrlProd = 'ZHVtbXk=';
  static const String supabasePublishableKeyProd = 'ZHVtbXk=';

  // ─── Sentry Config ──────────────────────────────────────────────────────────
  static const String sentryDsn = 'ZHVtbXk=';

  // ─── Backend & Bridge Config (Dev) ──────────────────────────────────────────
  /// Dev backend URL: loaded from --dart-define=GHOSTCLASS_DEV_URL or fallback.
  ///
  /// SECURITY: This is only compiled into debug builds. Release builds use [ghostclassApiUrlProd].
  /// To set a custom dev URL:
  ///   flutter run --dart-define=GHOSTCLASS_DEV_URL=https://192.168.x.x:3000/api
  ///   flutter run --debug --dart-define=GHOSTCLASS_DEV_URL=https://your-ip:port/api
  static const String ghostclassApiUrlDev = String.fromEnvironment(
    'GHOSTCLASS_DEV_URL',
    defaultValue: 'https://localhost:3000/api', // Safe default for debug builds
  );

  // ─── Backend & Bridge Config (Prod) ─────────────────────────────────────────
  /// Prod backend URL: hardcoded, safe to distribute in release builds.
  static const String ghostclassApiUrlProd =
      'https://ghostclass.devakesu.com/api';

  // ─── EzyGo Config (Shared: Dev + Prod) ─────────────────────────────────────
  /// Base64-encoded EzyGo auth URL
  static const String ezygoAuthUrl = 'ZHVtbXk=';

  /// Base64-encoded EzyGo API root
  static const String ezygoApiRoot = 'ZHVtbXk=';

  /// Base64-encoded EzyGo origin
  static const String ezygoOrigin = 'ZHVtbXk=';
}
