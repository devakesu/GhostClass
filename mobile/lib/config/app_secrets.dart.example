/// Template for AppSecrets. 
/// 
/// IMPORTANT: All sensitive string values are base64-encoded by the CI/CD workflow
/// (see .github/workflows/release.yml). This prevents sensitive values from appearing
/// in plaintext in the compiled binary.
/// 
/// TO USE FOR LOCAL DEVELOPMENT: 
/// 1. Copy this file to 'lib/config/app_secrets.dart'
/// 2. Base64-encode your values: echo -n 'value' | base64
/// 3. Fill in the encoded values below.
class AppSecrets {
  AppSecrets._();

  // ─── Environment ──────────────────────────────────────────────────────────
  
  static const bool isDev = kDebugMode;

  // ─── Supabase Config (Dev) ─────────────────────────────────────────────────
  /// Base64-encoded URL (echo -n 'https://...' | base64)
  static const String supabaseUrlDev = ''; 
  /// Base64-encoded key (echo -n 'sb_...' | base64)
  static const String supabasePublishableKeyDev = ''; 

  // ─── Supabase Config (Prod) ─────────────────────────────────────────────────
  /// Base64-encoded proxy URL (echo -n 'https://...' | base64)
  static const String supabaseProxyUrlProd = ''; 
  /// Base64-encoded key (echo -n 'sb_...' | base64)
  static const String supabasePublishableKeyProd = ''; 

  // ─── Sentry Config ──────────────────────────────────────────────────────────
  /// Base64-encoded Sentry DSN (echo -n 'https://...' | base64)
  static const String sentryDsn = ''; 

  // ─── Backend & Bridge Config (Dev) ──────────────────────────────────────────
  /// Dev backend URL: Use --dart-define=GHOSTCLASS_DEV_URL=... at build time
  static const String ghostclassApiUrlDev = String.fromEnvironment(
    'GHOSTCLASS_DEV_URL',
    defaultValue: 'https://localhost:3000/api',
  );

  // ─── Backend & Bridge Config (Prod) ─────────────────────────────────────────
  /// Production backend URL (Plain string, safe to hardcode for release builds)
  static const String ghostclassApiUrlProd = '';

  // ─── EzyGo Config (Shared: Dev + Prod) ─────────────────────────────────────
  /// Base64-encoded EzyGo auth URL
  static const String ezygoAuthUrl = ''; 
  /// Base64-encoded EzyGo API root
  static const String ezygoApiRoot = ''; 
  /// Base64-encoded EzyGo origin
  static const String ezygoOrigin = ''; 

  // ─── Supabase Config (Shared) ──────────────────────────────────────────────
  static const String supabaseSpoofedOrigin = '';
}
